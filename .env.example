# ============================================================
#  Crypto Desk secrets file
#  setup.bat copies this file to ".env". Put your real keys in
#  ".env", never in this file. ".env" is git-ignored and must
#  never be shared or committed.
#  Leave a line blank if you don't have that key yet.
# ============================================================

# ---- Trading mode -------------------------------------------
# Paper trading (fake money) unless this is exactly "true".
LIVE_TRADING=false

# ---- CoinSpot: READ-ONLY key (safe; used for paper mode) ----
# CoinSpot website -> Settings -> API -> "Read Only" key.
COINSPOT_READONLY_KEY=
COINSPOT_READONLY_SECRET=

# ---- CoinSpot: FULL ACCESS key (live trading only) ----------
# Only needed when LIVE_TRADING=true.
# NEVER tick the "withdraw" option when you create this key.
# The bot checks and refuses to run if withdrawals are enabled.
COINSPOT_KEY=
COINSPOT_SECRET=

# ---- Claude (Anthropic) API key - used from Stage 2 ---------
ANTHROPIC_API_KEY=

# ---- Telegram alerts - used from Stage 7 --------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional ------------------------------------------------
# CryptoPanic news API token (RSS news works without it)
CRYPTOPANIC_TOKEN=
# healthchecks.io ping URL - alerts you if the whole server dies
HEALTHCHECKS_URL=
# Password for the web dashboard (Stage 7)
DASHBOARD_PASSWORD=

# ---- Prop firm account (Tradeify 247, DXtrade) - R3 ---------
# From Tradeify 247 (your account page / their support):
# DXTRADE_URL is the API address, e.g. https://<their server>/dxsca-web
DXTRADE_URL=
DXTRADE_USERNAME=
DXTRADE_PASSWORD=
DXTRADE_DOMAIN=default
# Leave blank to trade every account on the login, or list account codes
DXTRADE_ACCOUNTS=
